# Copy to .env. Business data is entered by the user; roads come from configured services.
DISPATCH_DB=data/dispatch.sqlite
PUBLIC_APP_URL=http://127.0.0.1:8080
COOKIE_SECURE=false
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-car
PHOTON_BASE_URL=https://photon.komoot.io
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# OpenAI-compatible API protocol, including local/free model servers.
# Base URL includes /v1 where required. No paid API is needed.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=local-model

# Normalized gateways; provider-specific conversion described in docs/INTEGRATIONS.md.
MAP_BASE_URL=
MAP_API_KEY=
VEHICLE_BASE_URL=
VEHICLE_API_KEY=
